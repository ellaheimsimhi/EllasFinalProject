<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         x:Class="EllasFinalProject.Views.SignUpPage"
                         Title="SignUpPage">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="Purple"/>
            <GradientStop Offset="0.5" Color="#3a7bd5"/>
            <GradientStop Offset="1.0" Color="LightCyan"/>
        </LinearGradientBrush>

    </ContentPage.Background>
    <Grid
                        RowDefinitions ="*,4*,*"
                        ColumnDefinitions ="*,8*,*" >

        <HorizontalStackLayout
                            Grid.Column ="1"
                            HorizontalOptions ="Center"
                            VerticalOptions ="Center" >

            <Label
                            TextColor ="White"
                            Text ="Create Account"
                            FontSize ="24"/>
        </HorizontalStackLayout >
        <VerticalStackLayout
                    Grid.Row =" 1"
                    Grid.Column =" 1">

            <!--private name-->
            <Border
                  Margin =" 0,0,0,10 "
                  Padding ="10"
                  Stroke ="#ccc"
                  StrokeShape =" RoundRectangle 8"
                  StrokeThickness ="1">

                <Entry
                    FontSize =" 18 "
                    Placeholder ="First Name"
                    TextColor ="Wheat"
                    Text =""/>
            </Border>


            <!--family name-->
            <Border
                Margin =" 0,0,0,10 "
                Padding =" 10 "
                Stroke ="#ccc"
                StrokeShape =" RoundRectangle 8"
                StrokeThickness =" 1">
                <Entry
                   
                  FontSize =" 18 "
                  Placeholder ="Last Name"
                  TextColor ="Wheat"
                  Text =""/>
            </Border>


            <!--mail-->
            <Border
               Margin =" 0,0,0,10 "
               Padding =" 10 "
               Stroke ="#ccc"
               StrokeShape =" RoundRectangle 8"
               StrokeThickness =" 1">
                <Entry
                  
                 Keyboard ="Email"
                 FontSize =" 18 "
                 Placeholder ="Email"
                 TextColor ="Wheat"
                 Text =""/>
            </Border>

            <!--password-->
            <Border
            Margin =" 0,0,0,10 "
            Stroke ="#ccc"
            StrokeShape =" RoundRectangle 8"
            StrokeThickness =" 1">
                <Grid
                
                 Padding =" 10 "
                 ColumnDefinitions ="*,Auto"
                 VerticalOptions ="Center">

                    <Entry
                       x:Name="PasswordEntry"
                       IsPassword ="True"
                       BackgroundColor ="Transparent"
                       FontSize =" 18 "
                       Placeholder ="Password"
                       TextColor ="Wheat"
                       VerticalOptions ="Center"
                       Text =""/>

                    <Button
                        Margin="5,0,0,0"
                        Padding="0"
                        BackgroundColor ="Transparent"
                        FontSize =" 24 "
                        HorizontalOptions ="End"
                        TextColor ="White"
                        VerticalOptions ="Center"
                        FontFamily =" MaterialSymbolsFont "
                        Text ="&#xe8f5;"
                        Clicked ="TogglePassordButton"/>
                </Grid>
            </Border>
            <!--phone number-->
                <Border
                    Margin =" 0,0,0,10 "
                    Padding =" 10 "
                    Stroke ="#ccc"
                    StrokeShape =" RoundRectangle 8"
                    StrokeThickness =" 1">
                    <Entry
                      
                      Keyboard ="Telephone"
                      FontSize =" 18 "
                      Placeholder ="Mobile"
                      TextColor ="Wheat"
                      Text =""/>
                </Border>
            
                <!--sign in button-->
            <Button
                   
                    CornerRadius =" 8"
                    FontSize =" 20 "
                    HeightRequest =" 70 "
                    Text ="Sign Up"
                    TextColor ="White"/>


                <!-- already have an account? -->

                <HorizontalStackLayout
                    HorizontalOptions ="Center"
                    VerticalOptions ="Center">

                <Label 
                        Margin="0,10,0,0"
                        VerticalTextAlignment="Center"
                        TextColor="White"
                        Text="Already have an account?"
                        FontSize ="18"/>

                <Button
                        BackgroundColor="Transparent" 
                        FontSize="16"
                        TextColor="BlueViolet"
                        Text="SignIn"/>
                </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>